PORT=8787
APP_BASE_URL=http://localhost:8787

# --- ERC-8004 ---
# SELLER-owner wallet secret — registers the seller agent on 8004
STELLAR_SECRET_KEY=
# Filled automatically after `npm run register:seller`
SELLER_STELLAR_AGENT_ID=

# --- MPP Charge settlement (no facilitator) ---
# SELLER-owner public address (receives USDC)
STELLAR_RECIPIENT=
# Any long random string (signs MPP server state)
MPP_SECRET_KEY=
# BUYER-owner secret (sends USDC). MUST be a different wallet than the seller.
STELLAR_PAYER_SECRET=
# Optional: separate fee payer secret
FEE_PAYER_SECRET=

# --- Network ---
STELLAR_NETWORK=stellar:testnet

# --- LLM (fal.ai) for the chatbot; leave blank to use templated replies ---
FAL_KEY=
FAL_MODEL=google/gemini-flash-1.5
